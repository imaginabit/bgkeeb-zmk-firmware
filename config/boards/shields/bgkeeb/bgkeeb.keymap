#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/studio_unlock.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY base
        base {
            label = "Base";
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp A     &kp S     &kp D     &kp F     &kp G
                &kp Z     &kp X     &kp C     &kp V     &kp B
                          &none     &kp ENTER &kp SPACE &mo 1
            >;
        };

        // Layer 1: Números y símbolos (mantener thumb derecho)
        num {
            label = "Num";
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp MINUS &kp EQUAL &kp BSLH  &kp GRAVE &kp LBKT
                          &none     &kp ENTER &kp SPACE &kp LSHFT
            >;
        };

        // Combo: mantener Q+W un momento (&studio_unlock) para desbloquear ZMK Studio.
        // Posiciones de key-positions son (row, col) en el kscan. 0,0 = Q. 0,1 = W.
        combos {
            compatible = "zmk,combos";
            combo_studio_unlock {
                timeout-ms = <50>;
                bindings = <&studio_unlock>;
                key-positions = <0 0>, <0 1>;
            };
        };
    };
};

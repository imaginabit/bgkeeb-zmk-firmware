#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY base.
        // Tecla G (fila 1, col 4): &studio_unlock para desbloquear ZMK Studio.
        // Combo Q+W (key-positions = <0 0 0 1>): flat array de 4 ints = 2 pares row,col.
        base {
            label = "Base";
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp A     &kp S     &kp D     &kp F     &studio_unlock
                &kp Z     &kp X     &kp C     &kp V     &kp B
                          &none     &kp ENTER &kp SPACE &mo 1
            >;
        };

        // Layer 1: Números y símbolos (mantener thumb derecho)
        num {
            label = "Num";
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp MINUS &kp EQUAL &kp BSLH  &kp GRAVE &kp LBKT
                          &none     &kp ENTER &kp SPACE &kp LSHFT
            >;
        };

        // Combo Q+W: mantener ambas un instante → &studio_unlock.
        // Key-positions formato: array plano de 4 ints (2 pares row,col): <0 0 0 1>
        combos {
            compatible = "zmk,combos";
            combo_unlock {
                timeout-ms = <50>;
                bindings = <&studio_unlock>;
                key-positions = <0 0 0 1>;
            };
        };
    };
};

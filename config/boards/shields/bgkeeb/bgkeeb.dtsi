#include <dt-bindings/zmk/matrix_transform.h>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "bgkeeb default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <&key_0_0>, <&key_0_1>, <&key_0_2>, <&key_0_3>, <&key_0_4>,
               <&key_1_0>, <&key_1_1>, <&key_1_2>, <&key_1_3>, <&key_1_4>,
               <&key_2_0>, <&key_2_1>, <&key_2_2>, <&key_2_3>, <&key_2_4>,
               <&key_3_0>, <&key_3_1>, <&key_3_2>, <&key_3_3>, <&key_3_4>;
    };

    // Key physical attributes (used by ZMK Studio to render the physical layout)
    // Units are in "u" (1u = 19.05mm). Format: width, height, x, y, rotation, rx, ry
    key_0_0: key_phys_0_0 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <0>; y = <0>; };
    key_0_1: key_phys_0_1 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <1>; y = <0>; };
    key_0_2: key_phys_0_2 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <2>; y = <0>; };
    key_0_3: key_phys_0_3 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <3>; y = <0>; };
    key_0_4: key_phys_0_4 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <4>; y = <0>; };
    key_1_0: key_phys_1_0 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <0>; y = <1>; };
    key_1_1: key_phys_1_1 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <1>; y = <1>; };
    key_1_2: key_phys_1_2 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <2>; y = <1>; };
    key_1_3: key_phys_1_3 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <3>; y = <1>; };
    key_1_4: key_phys_1_4 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <4>; y = <1>; };
    key_2_0: key_phys_2_0 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <0>; y = <2>; };
    key_2_1: key_phys_2_1 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <1>; y = <2>; };
    key_2_2: key_phys_2_2 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <2>; y = <2>; };
    key_2_3: key_phys_2_3 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <3>; y = <2>; };
    key_2_4: key_phys_2_4 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <4>; y = <2>; };
    key_3_0: key_phys_3_0 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <0>; y = <3>; };
    key_3_1: key_phys_3_1 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <1>; y = <3>; };
    key_3_2: key_phys_3_2 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <2>; y = <3>; };
    key_3_3: key_phys_3_3 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <3>; y = <3>; };
    key_3_4: key_phys_3_4 { compatible = "zmk,key-physical-attrs"; width = <1>; height = <1>; x = <4>; y = <3>; };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        // #define MATRIX_ROW_PINS { F6, D7, B3, E6 }     == { 19, 6, 14, 7 }
        // #define MATRIX_COL_PINS { F4, D4, F5, B1, B2 } == { 21, 4, 20, 15, 16 }
        row-gpios
            = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    // #define ENCODERS_PAD_A {B5} {9} {A9}
    // #define ENCODERS_PAD_B {B4} {8} {A8}

    // #define ENCODER_RESOLUTION 2 ------- used default zmk values instead
    encoder: encoder {
        compatible = "alps,ec11";
        label = "encoder";
        a-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};
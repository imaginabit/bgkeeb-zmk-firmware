#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "bgkeeb default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  // width height x    y    r   rx  ry
            = <&key_physical_attrs 1 1 0 0 0 0 0>  /* RC(0,0) */
            , <&key_physical_attrs 1 1 1 0 0 0 0>  /* RC(0,1) */
            , <&key_physical_attrs 1 1 2 0 0 0 0>  /* RC(0,2) */
            , <&key_physical_attrs 1 1 3 0 0 0 0>  /* RC(0,3) */
            , <&key_physical_attrs 1 1 4 0 0 0 0>  /* RC(0,4) */
            , <&key_physical_attrs 1 1 0 1 0 0 0>  /* RC(1,0) */
            , <&key_physical_attrs 1 1 1 1 0 0 0>  /* RC(1,1) */
            , <&key_physical_attrs 1 1 2 1 0 0 0>  /* RC(1,2) */
            , <&key_physical_attrs 1 1 3 1 0 0 0>  /* RC(1,3) */
            , <&key_physical_attrs 1 1 4 1 0 0 0>  /* RC(1,4) */
            , <&key_physical_attrs 1 1 0 2 0 0 0>  /* RC(2,0) */
            , <&key_physical_attrs 1 1 1 2 0 0 0>  /* RC(2,1) */
            , <&key_physical_attrs 1 1 2 2 0 0 0>  /* RC(2,2) */
            , <&key_physical_attrs 1 1 3 2 0 0 0>  /* RC(2,3) */
            , <&key_physical_attrs 1 1 4 2 0 0 0>  /* RC(2,4) */
            , <&key_physical_attrs 1 1 0 3 0 0 0>  /* RC(3,0) - no physical key */
            , <&key_physical_attrs 1 1 1 3 0 0 0>  /* RC(3,1) - no physical key */
            , <&key_physical_attrs 1 1 2 3 0 0 0>  /* RC(3,2) thumb */
            , <&key_physical_attrs 1 1 3 3 0 0 0>  /* RC(3,3) thumb */
            , <&key_physical_attrs 1 1 4 3 0 0 0>  /* RC(3,4) thumb */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        // #define MATRIX_ROW_PINS { F6, D7, B3, E6 }     == { 19, 6, 14, 7 }
        // #define MATRIX_COL_PINS { F4, D4, F5, B1, B2 } == { 21, 4, 20, 15, 16 }
        row-gpios
            = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    // #define ENCODERS_PAD_A {B5} {9} {A9}
    // #define ENCODERS_PAD_B {B4} {8} {A8}

    // #define ENCODER_RESOLUTION 2 ------- used default zmk values instead
    encoder: encoder {
        compatible = "alps,ec11";
        label = "encoder";
        a-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};